-cp src
-cp ../aqw-haxe-api/src
-D air
-swf-version 40
-debug
-lib hscript
-swf bin/ModUI.swc

--macro include('ui')
--macro exclude('com.aqwapi')
--macro exclude('hscript')
# Exclude the concrete Overlay from ModUI.swc — aqw-mobile-mod supplies the
# real AS3 Overlay.as at runtime, so we must not ship a conflicting definition.
# The source stays concrete for clean type-checking; only the output is stripped.
--macro exclude('ui.Overlay')